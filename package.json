{
  "name": "loadstone",
  "private": true,
  "version": "0.2.4",
  "description": "Modern self-hosted panel for running Minecraft servers in Docker",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/lisaaqt/loadstone.git"
  },
  "homepage": "https://github.com/lisaaqt/loadstone",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @loadstone/panel",
    "dev:worker": "npm run dev:worker -w @loadstone/panel",
    "dev:agent": "npm run dev -w @loadstone/agent",
    "build": "npm run build -w @loadstone/agent && npm run build -w @loadstone/panel",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @loadstone/panel",
    "db:deploy": "npm run db:deploy -w @loadstone/panel",
    "server-bundle": "node scripts/build-server-upload.mjs",
    "push-images": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/push-images.ps1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "readdir-glob": "^4.0.0"
  }
}
