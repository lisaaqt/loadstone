# Loadstone server configuration.
# Copy to .env.docker, fill in every value marked "required", then run update.sh.
# Generate secrets with: openssl rand -hex 32

# ---- Panel ------------------------------------------------------------------
# Port on this server where the panel is published.
APP_PORT=3000
# required: URL people open in the browser. Use https:// behind a reverse proxy (enables secure cookies).
APP_URL=http://your-server-ip:3000
# required: 32+ random characters. Encrypts node tokens and S3 secrets; never change it after the first start.
APP_SECRET=
# Extra origins allowed to send changes (comma-separated), e.g. https://panel.example.com. Usually empty.
ALLOWED_ORIGINS=
# Set to true only when a reverse proxy in front of the panel sets X-Forwarded-For.
TRUST_PROXY=false

# ---- Update check -----------------------------------------------------------
# Admins see a warning in the panel when the registry has a newer version tag than the running panel.
UPDATE_CHECK=true
# Read-only login for the registry, only needed if it does not allow anonymous reads.
UPDATE_REGISTRY_USERNAME=
UPDATE_REGISTRY_PASSWORD=

# ---- Self-service servers ---------------------------------------------------
# How many servers a normal (non-admin) user may create themselves. 0 = only admins create servers.
USER_SERVER_LIMIT=0
# Most RAM / disk (MB) and CPU (100 = one core) each self-created server may get.
USER_SERVER_MAX_MEMORY_MB=4096
USER_SERVER_MAX_DISK_MB=20480
USER_SERVER_MAX_CPU_PERCENT=200

# ---- Database ---------------------------------------------------------------
# required: password of the bundled PostgreSQL. Never change it after the first start.
POSTGRES_PASSWORD=

# ---- Optional parts ---------------------------------------------------------
# Comma-separated: agent (run a node agent on this server), db-backup (database dumps to ./backups),
# s3 (MinIO backup storage, needs MINIO_IMAGE below).
COMPOSE_PROFILES=agent,db-backup

# ---- Node agent (profile "agent") -------------------------------------------
# required with "agent": 32+ random characters, shared by the panel and the agent.
LOADSTONE_AGENT_TOKEN=
# Name of this node in the panel. Defaults to the server's hostname.
NODE_NAME=
# required with "agent": IP or domain players use to connect to Minecraft servers on this machine.
NODE_PUBLIC_HOST=your-server-ip
# Ports handed out to Minecraft servers. Open them in your firewall.
NODE_PORT_START=25565
NODE_PORT_END=25665

# ---- Database backups (profile "db-backup") ---------------------------------
# Seconds between dumps (86400 = daily) and how many dumps to keep in ./backups.
DB_BACKUP_INTERVAL_SECONDS=86400
DB_BACKUP_KEEP=7

# ---- MinIO (profile "s3") ---------------------------------------------------
# The official minio/minio image is no longer published on Docker Hub; set an image you have access to.
MINIO_IMAGE=
MINIO_ROOT_USER=loadstone
MINIO_ROOT_PASSWORD=
