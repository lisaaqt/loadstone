# ---- Panel ---------------------------------------------------------------
# Public URL of the panel. Use https:// in production so cookies are marked Secure.
APP_URL=http://localhost:3000
# 32+ random characters. Encrypts node tokens and S3 secrets at rest. Generate: openssl rand -hex 32
APP_SECRET=
# Extra origins allowed to send mutating requests (comma-separated), e.g. https://panel.example.com
# Browsers that send Sec-Fetch-Site are verified automatically; this is only a fallback for older clients.
ALLOWED_ORIGINS=
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
PANEL_PORT=3000

# Used by docker-compose.yml
POSTGRES_PASSWORD=
# Used for local development outside Docker (see docker-compose.dev.yml)
DATABASE_URL=postgresql://loadstone:loadstone@localhost:5432/loadstone
REDIS_URL=redis://localhost:6379

# ---- Bundled agent (docker compose --profile agent) ----------------------
LOADSTONE_AGENT_TOKEN=

# ---- Optional MinIO (docker compose --profile s3) ------------------------
MINIO_ROOT_USER=loadstone
MINIO_ROOT_PASSWORD=
