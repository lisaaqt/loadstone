{
  "name": "@loadstone/panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && tsx watch --clear-screen=false --ignore ./src/app --ignore ./src/components server.ts",
    "dev:worker": "prisma generate && tsx watch --clear-screen=false worker.ts",
    "build": "prisma generate && next build && node build.mjs",
    "db:generate": "prisma generate",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@loadstone/shared": "^0.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@next/env": "^16.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "bullmq": "^6.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.4",
    "cronstrue": "^3.39.0",
    "geist": "^1.9.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.71.0",
    "monaco-editor": "^0.57.0",
    "mongodb": "^6.22.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
